<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LitterLoom - Dog Breeder Store</title>
    <style>
        :root {
          --primary-color: #d4a01e;
          --secondary-color: #5c3a21;
          --accent-color: #f6d149;
          --bg-color: #fdfaf6;
          --text-color: #333333;
        }

        body {
          background-color: var(--bg-color);
          color: var(--text-color);
          font-family: Arial, sans-serif;
          margin: 0;
          padding: 20px;
        }

        header {
          text-align: center;
          padding: 20px;
          border-bottom: 2px solid var(--primary-color);
        }

        h1, h2 {
          color: var(--secondary-color);
        }

        .container {
          max-width: 800px;
          margin: 0 auto;
        }

        .button {
          background-color: var(--primary-color);
          color: #fff;
          border: none;
          padding: 10px 20px;
          cursor: pointer;
          font-size: 16px;
        }

        .button:hover {
          background-color: var(--accent-color);
          color: var(--secondary-color);
        }

        .storefront {
            padding: 20px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>

    <header>
        <h1>LitterLoom</h1>
        <p>Your premier dog breeder document packages and templates.</p>
    </header>

    <div class="container">
        <div class="storefront">
            <h2>Welcome to our Store</h2>
            <p>Browse our collection of health records, bills of sale, and sales contracts.</p>
            <button class="button">View Packages</button>
        </div>
    </div>

</body>
</html>
